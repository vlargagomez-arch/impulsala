# Plantilla de variables para VPS/hosting propio. Copiar a .env en la raíz del proyecto
# y llenar con los valores reales (los nombres salen de `vercel env ls`).
# NUNCA commitear el .env lleno.

NODE_ENV=production

# Base de datos (Supabase actual o Postgres del VPS)
DATABASE_URL=

# Agentes IA (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Cron / endpoints de mantenimiento
CRON_SECRET=

# Correo (Gmail SMTP con contraseña de aplicación)
EMAIL_USER=
EMAIL_PASS=

# CRM
CRM_ADMIN_EMAIL=
CRM_ADMIN_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://impulsala.vercel.app

# Sitio
NEXT_PUBLIC_SITE_URL=https://impulsala.vercel.app

# Google Calendar (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://impulsala.vercel.app/api/google-calendar/callback

# Solo para docker-compose.yml (Postgres propio)
DOMAIN=impulsala.com
POSTGRES_PASSWORD=
